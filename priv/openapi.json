{
  "openapi": "3.1.0",
  "info": {
    "title": "Gobusgo API",
    "version": "1.0.0",
    "summary": "The public HTTP endpoints of Gobusgo.",
    "description": "The JSON endpoints a client outside the application's own pages may call: the agency API, the manifests of the published routing, address, and intersection files, and the MCP endpoint at `/mcp`. Every error is RFC 9457 problem details, except the JSON-RPC errors of `/mcp`. Static files, the browser pages, and the LiveView socket are not described; `GET /health` and `GET /ready` are in the operational document, `openapi.private.json`. Any method on a path under `/api` that no operation here names is answered `404` problem details, and any method but POST on `/mcp` is answered `405` (see `x-fallbacks`). This document is maintained by hand and a test checks only that its operations and catch-alls match the router, not that bodies match its schemas."
  },
  "servers": [
    {
      "url": "/",
      "description": "The origin the document is read from."
    }
  ],
  "security": [],
  "tags": [
    {
      "name": "Agencies",
      "description": "The agencies of the current OneBusAway fetch."
    },
    {
      "name": "Manifests",
      "description": "The manifests of the published routing, address, and intersection files."
    },
    {
      "name": "MCP",
      "description": "The Model Context Protocol endpoint."
    }
  ],
  "x-fallbacks": [
    {
      "path": "/api/*path",
      "methods": "any",
      "description": "Every method on a path under /api that no operation of this document names. OpenAPI paths cannot hold a wildcard, so the catch-all is stated here by the router's own path.",
      "responses": {
        "404": {
          "$ref": "#/components/responses/ApiRouteNotFound"
        }
      }
    },
    {
      "path": "/mcp",
      "methods": "any except POST",
      "description": "Every method but POST on /mcp. The Origin check of POST applies first, so a disallowed Origin is answered 403 with a JSON-RPC error.",
      "responses": {
        "405": {
          "$ref": "#/components/responses/McpMethodNotAllowed"
        }
      }
    }
  ],
  "paths": {
    "/api/agencies": {
      "get": {
        "operationId": "listAgencies",
        "tags": [
          "Agencies"
        ],
        "summary": "List the agencies of the current fetch",
        "description": "Every agency of the current fetch of the agency view, in identifier order.",
        "responses": {
          "200": {
            "description": "The agencies and the fetch they come from. `application/json; charset=utf-8`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgencyCollection"
                }
              }
            }
          },
          "406": {
            "$ref": "#/components/responses/NotAcceptable"
          },
          "503": {
            "$ref": "#/components/responses/AgencyUnavailable"
          }
        }
      }
    },
    "/api/agencies/{id}": {
      "get": {
        "operationId": "getAgency",
        "tags": [
          "Agencies"
        ],
        "summary": "Get one agency of the current fetch",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "The agency identifier.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The agency and the fetch it comes from. `application/json; charset=utf-8`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgencyResource"
                }
              }
            }
          },
          "404": {
            "description": "The current fetch holds no agency with that identifier. The `content-type` is `application/problem+json; charset=utf-8`.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "406": {
            "$ref": "#/components/responses/NotAcceptable"
          },
          "503": {
            "$ref": "#/components/responses/AgencyUnavailable"
          }
        }
      }
    },
    "/api/routing/manifest": {
      "get": {
        "operationId": "getRoutingManifest",
        "tags": [
          "Manifests"
        ],
        "summary": "Get the manifest of the routing snapshots",
        "description": "Names the snapshot files by addresses that never change content, so it is the one thing a reader revalidates. Answered `200` with an empty `snapshots` list before the first snapshot is built, never `503`.",
        "parameters": [
          {
            "$ref": "#/components/parameters/IfNoneMatch"
          }
        ],
        "responses": {
          "200": {
            "description": "The manifest as canonical JSON, `application/json; charset=utf-8`.",
            "headers": {
              "ETag": {
                "$ref": "#/components/headers/ETag"
              },
              "Cache-Control": {
                "$ref": "#/components/headers/CacheControl"
              },
              "Access-Control-Allow-Origin": {
                "$ref": "#/components/headers/AccessControlAllowOrigin"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RoutingManifest"
                }
              }
            }
          },
          "304": {
            "description": "The `if-none-match` header names the current `etag`. No body.",
            "headers": {
              "ETag": {
                "$ref": "#/components/headers/ETag"
              },
              "Cache-Control": {
                "$ref": "#/components/headers/CacheControl"
              },
              "Access-Control-Allow-Origin": {
                "$ref": "#/components/headers/AccessControlAllowOrigin"
              }
            }
          },
          "406": {
            "$ref": "#/components/responses/NotAcceptable"
          }
        }
      },
      "head": {
        "operationId": "headRoutingManifest",
        "tags": [
          "Manifests"
        ],
        "summary": "Check the manifest of the routing snapshots",
        "description": "The status and headers the `GET` of this path answers, with no body.",
        "parameters": [
          {
            "$ref": "#/components/parameters/IfNoneMatch"
          }
        ],
        "responses": {
          "200": {
            "description": "The manifest as canonical JSON, `application/json; charset=utf-8`.",
            "headers": {
              "ETag": {
                "$ref": "#/components/headers/ETag"
              },
              "Cache-Control": {
                "$ref": "#/components/headers/CacheControl"
              },
              "Access-Control-Allow-Origin": {
                "$ref": "#/components/headers/AccessControlAllowOrigin"
              }
            }
          },
          "304": {
            "description": "The `if-none-match` header names the current `etag`. No body.",
            "headers": {
              "ETag": {
                "$ref": "#/components/headers/ETag"
              },
              "Cache-Control": {
                "$ref": "#/components/headers/CacheControl"
              },
              "Access-Control-Allow-Origin": {
                "$ref": "#/components/headers/AccessControlAllowOrigin"
              }
            }
          },
          "406": {
            "$ref": "#/components/responses/NotAcceptable"
          }
        }
      }
    },
    "/api/addresses/manifest": {
      "get": {
        "operationId": "getAddressesManifest",
        "tags": [
          "Manifests"
        ],
        "summary": "Get the manifest of the address shards",
        "description": "Every county's current manifest of the address shards.",
        "parameters": [
          {
            "$ref": "#/components/parameters/IfNoneMatch"
          }
        ],
        "responses": {
          "200": {
            "description": "The manifest as canonical JSON, `application/json; charset=utf-8`.",
            "headers": {
              "ETag": {
                "$ref": "#/components/headers/ETag"
              },
              "Cache-Control": {
                "$ref": "#/components/headers/CacheControl"
              },
              "Access-Control-Allow-Origin": {
                "$ref": "#/components/headers/AccessControlAllowOrigin"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AddressesManifest"
                }
              }
            }
          },
          "304": {
            "description": "The `if-none-match` header names the current `etag`. No body.",
            "headers": {
              "ETag": {
                "$ref": "#/components/headers/ETag"
              },
              "Cache-Control": {
                "$ref": "#/components/headers/CacheControl"
              },
              "Access-Control-Allow-Origin": {
                "$ref": "#/components/headers/AccessControlAllowOrigin"
              }
            }
          },
          "503": {
            "$ref": "#/components/responses/ManifestUnavailable"
          },
          "406": {
            "$ref": "#/components/responses/NotAcceptable"
          }
        }
      },
      "head": {
        "operationId": "headAddressesManifest",
        "tags": [
          "Manifests"
        ],
        "summary": "Check the manifest of the address shards",
        "description": "The status and headers the `GET` of this path answers, with no body.",
        "parameters": [
          {
            "$ref": "#/components/parameters/IfNoneMatch"
          }
        ],
        "responses": {
          "200": {
            "description": "The manifest as canonical JSON, `application/json; charset=utf-8`.",
            "headers": {
              "ETag": {
                "$ref": "#/components/headers/ETag"
              },
              "Cache-Control": {
                "$ref": "#/components/headers/CacheControl"
              },
              "Access-Control-Allow-Origin": {
                "$ref": "#/components/headers/AccessControlAllowOrigin"
              }
            }
          },
          "304": {
            "description": "The `if-none-match` header names the current `etag`. No body.",
            "headers": {
              "ETag": {
                "$ref": "#/components/headers/ETag"
              },
              "Cache-Control": {
                "$ref": "#/components/headers/CacheControl"
              },
              "Access-Control-Allow-Origin": {
                "$ref": "#/components/headers/AccessControlAllowOrigin"
              }
            }
          },
          "503": {
            "$ref": "#/components/responses/ManifestUnavailable"
          },
          "406": {
            "$ref": "#/components/responses/NotAcceptable"
          }
        }
      }
    },
    "/api/intersections/manifest": {
      "get": {
        "operationId": "getIntersectionsManifest",
        "tags": [
          "Manifests"
        ],
        "summary": "Get the manifest of the intersection files",
        "description": "The newest manifest of the intersection files, read from the store on each request.",
        "parameters": [
          {
            "$ref": "#/components/parameters/IfNoneMatch"
          }
        ],
        "responses": {
          "200": {
            "description": "The manifest as canonical JSON, `application/json; charset=utf-8`.",
            "headers": {
              "ETag": {
                "$ref": "#/components/headers/ETag"
              },
              "Cache-Control": {
                "$ref": "#/components/headers/CacheControl"
              },
              "Access-Control-Allow-Origin": {
                "$ref": "#/components/headers/AccessControlAllowOrigin"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IntersectionsManifest"
                }
              }
            }
          },
          "304": {
            "description": "The `if-none-match` header names the current `etag`. No body.",
            "headers": {
              "ETag": {
                "$ref": "#/components/headers/ETag"
              },
              "Cache-Control": {
                "$ref": "#/components/headers/CacheControl"
              },
              "Access-Control-Allow-Origin": {
                "$ref": "#/components/headers/AccessControlAllowOrigin"
              }
            }
          },
          "503": {
            "$ref": "#/components/responses/ManifestUnavailable"
          },
          "406": {
            "$ref": "#/components/responses/NotAcceptable"
          }
        }
      },
      "head": {
        "operationId": "headIntersectionsManifest",
        "tags": [
          "Manifests"
        ],
        "summary": "Check the manifest of the intersection files",
        "description": "The status and headers the `GET` of this path answers, with no body.",
        "parameters": [
          {
            "$ref": "#/components/parameters/IfNoneMatch"
          }
        ],
        "responses": {
          "200": {
            "description": "The manifest as canonical JSON, `application/json; charset=utf-8`.",
            "headers": {
              "ETag": {
                "$ref": "#/components/headers/ETag"
              },
              "Cache-Control": {
                "$ref": "#/components/headers/CacheControl"
              },
              "Access-Control-Allow-Origin": {
                "$ref": "#/components/headers/AccessControlAllowOrigin"
              }
            }
          },
          "304": {
            "description": "The `if-none-match` header names the current `etag`. No body.",
            "headers": {
              "ETag": {
                "$ref": "#/components/headers/ETag"
              },
              "Cache-Control": {
                "$ref": "#/components/headers/CacheControl"
              },
              "Access-Control-Allow-Origin": {
                "$ref": "#/components/headers/AccessControlAllowOrigin"
              }
            }
          },
          "503": {
            "$ref": "#/components/responses/ManifestUnavailable"
          },
          "406": {
            "$ref": "#/components/responses/NotAcceptable"
          }
        }
      }
    },
    "/mcp": {
      "post": {
        "operationId": "postMcp",
        "tags": [
          "MCP"
        ],
        "summary": "Send one JSON-RPC message to the MCP server",
        "description": "The MCP Streamable HTTP transport, answered as one JSON object and never a stream, with no session id. The body is read up to 1 MiB. Only the HTTP level is described here: the MCP methods and their params are the protocol's. The router's JSON pipeline answers 406 first when `Accept` names no JSON.",
        "parameters": [
          {
            "$ref": "#/components/parameters/McpProtocolVersion"
          },
          {
            "$ref": "#/components/parameters/McpMethod"
          },
          {
            "$ref": "#/components/parameters/McpName"
          },
          {
            "$ref": "#/components/parameters/Origin"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/JsonRpcRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "A JSON-RPC success, or a JSON-RPC error that the protocol answers under 200 (an unknown tool, bad arguments, an unknown resource, and, to a request of a legacy revision, an unknown method). `application/json; charset=utf-8`; the media type stays JSON under an error status.",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/JsonRpcSuccess"
                    },
                    {
                      "$ref": "#/components/schemas/JsonRpcError"
                    }
                  ]
                }
              }
            }
          },
          "202": {
            "description": "The message was a notification. No body."
          },
          "400": {
            "description": "A JSON-RPC error: a body that is not JSON (-32700), a message that is not one request or notification (-32600), a request of 2026-07-28 with a missing `_meta` field (-32602), headers that disagree with the body (-32020), or an unsupported protocol version (-32022). `application/json; charset=utf-8`; the media type stays JSON under an error status.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonRpcError"
                }
              }
            }
          },
          "403": {
            "description": "A JSON-RPC error, -32600 `Origin not allowed`: the `Origin` header names a host other than the public host, is malformed, or is sent more than once. Answered before the body is read. `application/json; charset=utf-8`; the media type stays JSON under an error status.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonRpcError"
                }
              }
            }
          },
          "404": {
            "description": "A JSON-RPC error, -32601, to a request of 2026-07-28 that names an unknown method. `application/json; charset=utf-8`; the media type stays JSON under an error status.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonRpcError"
                }
              }
            }
          },
          "406": {
            "$ref": "#/components/responses/NotAcceptable"
          },
          "413": {
            "description": "A JSON-RPC error, -32600 `Request body too large`: the body exceeds 1,048,576 bytes. `application/json; charset=utf-8`; the media type stays JSON under an error status.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonRpcError"
                }
              }
            }
          },
          "500": {
            "description": "A JSON-RPC error, -32603: the server failed to answer a well-formed request, such as a resource that is not available. `application/json; charset=utf-8`; the media type stays JSON under an error status.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonRpcError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "IfNoneMatch": {
        "name": "If-None-Match",
        "in": "header",
        "required": false,
        "description": "An entity tag the client holds. When it equals the current `etag` the answer is `304` with no body.",
        "schema": {
          "type": "string"
        }
      },
      "McpProtocolVersion": {
        "name": "MCP-Protocol-Version",
        "in": "header",
        "required": false,
        "description": "The protocol revision of the request: absent, `2025-11-25`, `2025-06-18`, or `2025-03-26` for the legacy revisions, or `2026-07-28`. Any other value is answered 400 with -32022.",
        "schema": {
          "type": "string"
        }
      },
      "McpMethod": {
        "name": "Mcp-Method",
        "in": "header",
        "required": false,
        "description": "Required of a request of 2026-07-28, which answers 400 with -32020 when it is missing or differs from the body's `method`. A repeated header counts as missing.",
        "schema": {
          "type": "string"
        }
      },
      "McpName": {
        "name": "Mcp-Name",
        "in": "header",
        "required": false,
        "description": "Required of a 2026-07-28 request that names a target (a tool or a resource), which answers 400 with -32020 when it is missing or differs from the target in the body.",
        "schema": {
          "type": "string"
        }
      },
      "Origin": {
        "name": "Origin",
        "in": "header",
        "required": false,
        "description": "A browser's origin. With none, or with the public host's, the request proceeds; any other, malformed, or repeated origin is answered 403. Where no public host is configured every origin proceeds. No CORS header is set.",
        "schema": {
          "type": "string"
        }
      }
    },
    "headers": {
      "ETag": {
        "description": "A strong entity tag: the quoted lowercase hexadecimal SHA-256 of the body.",
        "schema": {
          "type": "string",
          "pattern": "^\"[0-9a-f]{64}\"$"
        }
      },
      "CacheControl": {
        "description": "Always `no-cache`: the manifest is revalidated on every use.",
        "schema": {
          "type": "string",
          "const": "no-cache"
        }
      },
      "AccessControlAllowOrigin": {
        "description": "`*`, so a page of any origin, such as the trip planner app in a frame its host picks, reads the manifest.",
        "schema": {
          "type": "string",
          "const": "*"
        }
      }
    },
    "responses": {
      "NotAcceptable": {
        "description": "The `Accept` header names no JSON media type. The body is problem details as `application/problem+json; charset=utf-8`, except that a request that accepts HTML first is answered with an HTML error page.",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          },
          "text/html": {
            "schema": {
              "type": "string"
            }
          }
        }
      },
      "AgencyUnavailable": {
        "description": "The agency view has no current fetch yet. The `content-type` is `application/problem+json; charset=utf-8`.",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        },
        "headers": {
          "Retry-After": {
            "description": "Seconds to wait before the request is repeated.",
            "required": true,
            "schema": {
              "type": "integer",
              "const": 5
            }
          }
        }
      },
      "ManifestUnavailable": {
        "description": "No build is stored yet, or, for the intersection manifest, the stored manifest cannot be read or is not the JSON object a build writes. The `content-type` is `application/problem+json; charset=utf-8`.",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        },
        "headers": {
          "Retry-After": {
            "description": "Seconds to wait before the request is repeated.",
            "required": true,
            "schema": {
              "type": "integer",
              "const": 60
            }
          }
        }
      },
      "ApiRouteNotFound": {
        "description": "No route under `/api` matches the method and path; `detail` is `No route matches <METHOD> <path>.`. The `content-type` is `application/problem+json; charset=utf-8`.",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "McpMethodNotAllowed": {
        "description": "The MCP endpoint answers POST and offers no stream. The `content-type` is `application/problem+json; charset=utf-8`.",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        },
        "headers": {
          "Allow": {
            "description": "The methods the endpoint answers.",
            "required": true,
            "schema": {
              "type": "string",
              "const": "POST"
            }
          }
        }
      }
    },
    "schemas": {
      "Problem": {
        "type": "object",
        "description": "An RFC 9457 problem details object. `type` is always `about:blank`, so `title` is the HTTP reason phrase of `status`.",
        "required": [
          "type",
          "title",
          "status"
        ],
        "properties": {
          "type": {
            "type": "string",
            "const": "about:blank"
          },
          "title": {
            "type": "string",
            "description": "The reason phrase of `status`, such as `Not Found`."
          },
          "status": {
            "type": "integer",
            "minimum": 400,
            "maximum": 599
          },
          "detail": {
            "type": "string",
            "description": "Present only where the application writes the explanation itself; the message of an unexpected error never appears."
          }
        }
      },
      "Agency": {
        "type": "object",
        "description": "An agency of the current fetch of the agency view.",
        "required": [
          "id",
          "name",
          "url",
          "timezone",
          "coverage"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "timezone": {
            "type": "string",
            "description": "An IANA time zone name as the OneBusAway server reports it."
          },
          "coverage": {
            "type": "object",
            "description": "The center and the whole height and width, in degrees, of the box the agency covers. All four are 0 for an agency with no coverage.",
            "required": [
              "lat",
              "lon",
              "latSpan",
              "lonSpan"
            ],
            "additionalProperties": false,
            "properties": {
              "lat": {
                "type": "number"
              },
              "lon": {
                "type": "number"
              },
              "latSpan": {
                "type": "number"
              },
              "lonSpan": {
                "type": "number"
              }
            }
          }
        }
      },
      "AgencyCollection": {
        "type": "object",
        "required": [
          "data",
          "meta"
        ],
        "additionalProperties": false,
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Agency"
            }
          },
          "meta": {
            "type": "object",
            "required": [
              "fetchedAt",
              "requestId",
              "count"
            ],
            "additionalProperties": false,
            "properties": {
              "fetchedAt": {
                "type": "string",
                "format": "date-time",
                "description": "When the fetch the data comes from was made, in UTC."
              },
              "requestId": {
                "type": "string",
                "description": "The identifier of that fetch."
              },
              "count": {
                "type": "integer",
                "minimum": 0,
                "description": "The number of agencies in `data`."
              }
            }
          }
        }
      },
      "AgencyResource": {
        "type": "object",
        "required": [
          "data",
          "meta"
        ],
        "additionalProperties": false,
        "properties": {
          "data": {
            "$ref": "#/components/schemas/Agency"
          },
          "meta": {
            "type": "object",
            "required": [
              "fetchedAt",
              "requestId"
            ],
            "additionalProperties": false,
            "properties": {
              "fetchedAt": {
                "type": "string",
                "format": "date-time",
                "description": "When the fetch the data comes from was made, in UTC."
              },
              "requestId": {
                "type": "string",
                "description": "The identifier of that fetch."
              }
            }
          }
        }
      },
      "ManifestFile": {
        "type": "object",
        "description": "A published file: its URL path, its size in bytes as stored, and the SHA-256 of the stored bytes (the gzip stream for a compressed file), which also names the file.",
        "required": [
          "path",
          "byteSize",
          "sha256"
        ],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^/",
            "description": "The URL path the file is served at."
          },
          "byteSize": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "description": "Lowercase hexadecimal SHA-256."
          }
        }
      },
      "ManifestShardFile": {
        "description": "A shard file: a published file and the prefix of the street names it holds.",
        "allOf": [
          {
            "$ref": "#/components/schemas/ManifestFile"
          },
          {
            "type": "object",
            "required": [
              "prefix"
            ],
            "properties": {
              "prefix": {
                "type": "string",
                "description": "The name-key prefix the shard is named by."
              }
            }
          }
        ],
        "unevaluatedProperties": false
      },
      "RoutingManifest": {
        "type": "object",
        "description": "The manifest of the routing snapshots held by this node. It is built on each start, so it is empty before the first snapshot is recorded.",
        "required": [
          "formatVersion",
          "snapshots"
        ],
        "additionalProperties": false,
        "properties": {
          "formatVersion": {
            "type": "integer",
            "minimum": 1,
            "description": "The version of the packed snapshot files."
          },
          "snapshots": {
            "type": "array",
            "description": "One entry per service date, in date order.",
            "items": {
              "$ref": "#/components/schemas/RoutingSnapshot"
            }
          }
        }
      },
      "RoutingSnapshot": {
        "type": "object",
        "required": [
          "serviceDate",
          "serviceDayStartMs",
          "previousServiceDateIncluded",
          "builtAt",
          "sourceFetchedAt",
          "routeCount",
          "stopCount",
          "tripCount",
          "connectionCount",
          "transferRules",
          "walkingLinkCount",
          "files",
          "connectionChunks"
        ],
        "additionalProperties": false,
        "properties": {
          "serviceDate": {
            "type": "string",
            "format": "date"
          },
          "serviceDayStartMs": {
            "type": "integer",
            "format": "int64",
            "description": "The start of the service day, in milliseconds since the Unix epoch."
          },
          "previousServiceDateIncluded": {
            "type": "boolean",
            "description": "Whether the snapshot holds the previous service date's trips that run past midnight."
          },
          "builtAt": {
            "type": "string",
            "format": "date-time"
          },
          "sourceFetchedAt": {
            "type": "object",
            "description": "The freshness of the schedules the snapshot was built from.",
            "required": [
              "oldest",
              "newest"
            ],
            "additionalProperties": false,
            "properties": {
              "oldest": {
                "type": "string",
                "format": "date-time"
              },
              "newest": {
                "type": "string",
                "format": "date-time"
              }
            }
          },
          "routeCount": {
            "type": "integer",
            "minimum": 0
          },
          "stopCount": {
            "type": "integer",
            "minimum": 0
          },
          "tripCount": {
            "type": "integer",
            "minimum": 0
          },
          "connectionCount": {
            "type": "integer",
            "minimum": 0
          },
          "transferRules": {
            "type": "object",
            "description": "The rules the walking links and transfers were built with.",
            "required": [
              "minimumTransferS",
              "walkRadiusM",
              "walkSpeedMPerS",
              "walkLinkCountPerStopMax"
            ],
            "additionalProperties": false,
            "properties": {
              "minimumTransferS": {
                "type": "integer",
                "minimum": 0
              },
              "walkRadiusM": {
                "type": "integer",
                "minimum": 0
              },
              "walkSpeedMPerS": {
                "type": "number",
                "minimum": 0
              },
              "walkLinkCountPerStopMax": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          "walkingLinkCount": {
            "type": "integer",
            "minimum": 0
          },
          "files": {
            "type": "object",
            "description": "The snapshot's files by kind. `tripPaths` is present where the date's trip paths were built.",
            "required": [
              "stops",
              "trips",
              "transfers",
              "positions",
              "names"
            ],
            "additionalProperties": false,
            "properties": {
              "stops": {
                "$ref": "#/components/schemas/ManifestFile"
              },
              "trips": {
                "$ref": "#/components/schemas/ManifestFile"
              },
              "transfers": {
                "$ref": "#/components/schemas/ManifestFile"
              },
              "positions": {
                "$ref": "#/components/schemas/ManifestFile"
              },
              "names": {
                "$ref": "#/components/schemas/ManifestFile"
              },
              "tripPaths": {
                "$ref": "#/components/schemas/ManifestFile"
              }
            }
          },
          "connectionChunks": {
            "type": "array",
            "description": "The connection files in departure order.",
            "items": {
              "$ref": "#/components/schemas/ConnectionChunk"
            }
          }
        }
      },
      "ConnectionChunk": {
        "description": "A connection file and the span of departures it holds.",
        "allOf": [
          {
            "$ref": "#/components/schemas/ManifestFile"
          },
          {
            "type": "object",
            "required": [
              "departureSMin",
              "departureSMax",
              "count"
            ],
            "properties": {
              "departureSMin": {
                "type": "integer",
                "description": "The earliest departure in the chunk, in seconds from the service day's start."
              },
              "departureSMax": {
                "type": "integer",
                "description": "The latest departure in the chunk, in seconds from the service day's start."
              },
              "count": {
                "type": "integer",
                "minimum": 1,
                "description": "The number of connections in the chunk."
              }
            }
          }
        ],
        "unevaluatedProperties": false
      },
      "AddressesManifest": {
        "type": "object",
        "description": "Every county's current manifest of the address shards, in the order of the counties' names.",
        "required": [
          "counties"
        ],
        "additionalProperties": false,
        "properties": {
          "counties": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AddressCountyManifest"
            }
          }
        }
      },
      "AddressCountyManifest": {
        "type": "object",
        "required": [
          "county",
          "builtAt",
          "sourceLastEditAt",
          "recordCount",
          "inputsSha256",
          "addressCount",
          "streetCount",
          "index",
          "shards"
        ],
        "additionalProperties": false,
        "properties": {
          "county": {
            "type": "string",
            "pattern": "^[a-z_]+$",
            "description": "The lowercase county name, such as `king`."
          },
          "builtAt": {
            "type": "string",
            "format": "date-time"
          },
          "sourceLastEditAt": {
            "type": "string",
            "format": "date-time",
            "description": "The last edit of the county's source layer."
          },
          "recordCount": {
            "type": "integer",
            "minimum": 0,
            "description": "The record count of the county's source layer."
          },
          "inputsSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "description": "The SHA-256 of the build's accepted addresses."
          },
          "addressCount": {
            "type": "integer",
            "minimum": 0
          },
          "streetCount": {
            "type": "integer",
            "minimum": 0
          },
          "index": {
            "$ref": "#/components/schemas/ManifestFile"
          },
          "shards": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ManifestShardFile"
            }
          }
        }
      },
      "IntersectionsManifest": {
        "type": "object",
        "description": "The newest manifest of the published intersection files, a derivative database of OpenStreetMap under the ODbL.",
        "required": [
          "attribution",
          "builtAt",
          "index",
          "intersectionCount",
          "license",
          "shards",
          "sourceDate",
          "streetCount"
        ],
        "additionalProperties": false,
        "properties": {
          "attribution": {
            "type": "string",
            "const": "© OpenStreetMap contributors"
          },
          "builtAt": {
            "type": "string",
            "format": "date-time"
          },
          "index": {
            "$ref": "#/components/schemas/ManifestFile"
          },
          "intersectionCount": {
            "type": "integer",
            "minimum": 0
          },
          "license": {
            "type": "object",
            "required": [
              "name",
              "url"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "const": "Open Database License 1.0"
              },
              "url": {
                "type": "string",
                "format": "uri",
                "const": "https://opendatacommons.org/licenses/odbl/1-0/"
              }
            }
          },
          "shards": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ManifestShardFile"
            }
          },
          "sourceDate": {
            "type": "string",
            "format": "date-time",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
            "description": "The timestamp of the OpenStreetMap extract, UTC."
          },
          "streetCount": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "JsonRpcRequest": {
        "type": "object",
        "description": "One JSON-RPC 2.0 request, or notification when `id` is absent. A batch is refused with `-32600`. The MCP methods and their params are the protocol's, not modeled here.",
        "required": [
          "jsonrpc",
          "method"
        ],
        "properties": {
          "jsonrpc": {
            "type": "string",
            "const": "2.0"
          },
          "id": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              }
            ],
            "description": "The request's identifier. A message without one is a notification."
          },
          "method": {
            "type": "string"
          },
          "params": {
            "type": "object",
            "description": "A request of the 2026-07-28 revision carries the protocol version and the client capabilities in `params._meta`."
          }
        }
      },
      "JsonRpcSuccess": {
        "type": "object",
        "required": [
          "jsonrpc",
          "id",
          "result"
        ],
        "properties": {
          "jsonrpc": {
            "type": "string",
            "const": "2.0"
          },
          "id": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              }
            ],
            "description": "The request's identifier. A message without one is a notification."
          },
          "result": {
            "type": "object",
            "description": "The method's result. Under the 2026-07-28 revision it also holds `resultType`, `_meta`, and, for discovery, the lists, and `resources/read`, `ttlMs` and `cacheScope`."
          }
        }
      },
      "JsonRpcError": {
        "type": "object",
        "required": [
          "jsonrpc",
          "id",
          "error"
        ],
        "properties": {
          "jsonrpc": {
            "type": "string",
            "const": "2.0"
          },
          "id": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "The request's identifier, null where none could be read."
          },
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "integer",
                "description": "-32700, -32600, -32601, -32602, -32603 as JSON-RPC defines them; -32020 for headers that disagree with the body or a missing required header, -32022 for an unsupported protocol version; -32002 for a resource not found under the legacy revisions."
              },
              "message": {
                "type": "string"
              },
              "data": {
                "type": "object",
                "description": "For -32022, `supported` and `requested` protocol versions; for a resource not found, its `uri`."
              }
            }
          }
        }
      }
    }
  }
}
