# Mix build artifacts
/_build/
/deps/
/cover/
/doc/
erl_crash.dump
*.ez
gobusgo-*.tar

# Local configuration and secrets
.env
.env.*
!.env.example
/config/*.secret.exs
*.secret.exs

# Editor and OS
.elixir_ls/
.DS_Store

# Local file writer output
/data/
/tmp/

# Basemap archives, wherever an extraction writes them
*.pmtiles
*.pmtiles.partial

# Vendored front-end assets, downloaded by mix gobusgo.vendor.fetch
/assets/vendor/
/priv/vendor/

# Built assets
/priv/static/assets/
/priv/static/cache_manifest.json
/priv/static/sw.js

# The accessibility lint tool's packages, and the pages it lints
/tools/lint/node_modules/
/tools/lint/rendered/

# The conformance suite's packages, and the screenshots vitest takes of a failure
/tools/conformance/node_modules/
/tools/conformance/.vitest/
