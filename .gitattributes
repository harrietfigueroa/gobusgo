# Git's built-in diff patterns put the enclosing heading or selector in each hunk header.
# Elixir files keep git's default hunk headers: on macOS, git's built-in elixir pattern segfaults the system regexec on some diffs (GOB-387).
*.md diff=markdown
*.css diff=css

# GitHub folds this lock file in pull request diffs. mix.lock and assets/vendor.lock.json stay unfolded, since a reviewer reads them to see a dependency change.
tools/lint/package-lock.json linguist-generated

test/fixtures/**/*.bin binary
