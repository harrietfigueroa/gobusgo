# Copy to .env (ignored by git) and export before running: set -a; source .env; set +a
ONEBUSAWAY_BASE_URL=https://oba.example.com
ONEBUSAWAY_API_KEY=replace-me
GOBUSGO_HTTP_HOST=127.0.0.1
GOBUSGO_HTTP_PORT=4000
# Where stored responses are written and read. Unset or blank: data/ under the working directory.
GOBUSGO_DATA_DIR=
# Set to keep stored responses and usage records in an S3 bucket in place of GOBUSGO_DATA_DIR.
# Leave unset in development and test. The credentials are the task role's, never a setting.
GOBUSGO_S3_BUCKET=
# Required with a bucket: its region.
GOBUSGO_S3_REGION=
# Optional: a key prefix that ends in /, and the https address the bucket is reached at.
GOBUSGO_S3_PREFIX=
GOBUSGO_S3_ENDPOINT=
# Required in production, where it must hold at least 64 bytes: mix phx.gen.secret
# Leave unset in development and test; a random secret is generated at startup.
SECRET_KEY_BASE=
# Required in production: the host name pages are served on, with no scheme, port, or path.
# Leave unset in development and test, where the socket accepts every origin.
GOBUSGO_PUBLIC_HOST=
# The full commit the application was built from, which /health and the pages name.
# The image build sets it from its GOBUSGO_REVISION build argument. Leave unset in development and test.
GOBUSGO_REVISION=
# The https address the pages' donation button links. Unset or blank: no button and no donation section.
GOBUSGO_DONATION_URL=
