# Copy to .env (ignored by git) and export before running: set -a; source .env; set +a
ONEBUSAWAY_BASE_URL=https://oba.example.com
ONEBUSAWAY_API_KEY=replace-me
GOBUSGO_HTTP_HOST=127.0.0.1
GOBUSGO_HTTP_PORT=4000
# Where stored responses are written and read. Unset or blank: data/ under the working directory.
GOBUSGO_DATA_DIR=
# Required in production, where it must hold at least 64 bytes: mix phx.gen.secret
# Leave unset in development and test; a random secret is generated at startup.
SECRET_KEY_BASE=
# Required in production: the host name pages are served on, with no scheme, port, or path.
# Leave unset in development and test, where the socket accepts every origin.
GOBUSGO_PUBLIC_HOST=
